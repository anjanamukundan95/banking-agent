# Azure AI Foundry
AZURE_AI_PROJECT_ENDPOINT=https://<your-foundry-resource>.services.ai.azure.com/api/projects/<project-name>
MODEL_NAME=gpt-4o

# Azure AI Search
AZURE_SEARCH_ENDPOINT=https://<your-search-service>.search.windows.net
AZURE_SEARCH_INDEX_NAME=<your-index-name>
AZURE_SEARCH_SEMANTIC_CONFIGURATION=<your-semantic-configuration-name>

# Agent
AZURE_AI_AGENT_NAME=uae-banking-agent

# Banking API (use WireMock for local dev)
BANKING_API_BASE_URL=http://localhost:8090

# Microsoft Entra ID — JWT authentication
AUTH_ISSUER=https://sts.windows.net/<your-tenant-id>/
AUTH_AUDIENCE=api://<your-app-registration-client-id>
AUTH_JWKS_URL=https://login.microsoftonline.com/<your-tenant-id>/discovery/v2.0/keys
